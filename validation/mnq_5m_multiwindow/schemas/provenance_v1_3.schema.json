{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sikaodeluwei/trader_v1/validation/mnq_5m_multiwindow/schemas/provenance_v1_3.schema.json",
  "title": "MNQ 5-minute cohort source provenance with versioned inventory bindings", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "cohort_id", "case_id", "contract", "ninjatrader_version", "provider_acquisition", "application_timezone", "pc_log_timezone", "trading_hours", "bar_series", "source", "artifact_hashes", "selection_binding", "inventory_binding", "exclusion_binding", "toolset_binding", "trusted_inventory_checkpoint", "checkpoint_verification", "selected_source_binding", "source_quality_findings", "transformations", "approved_policy"],
  "properties": {
    "schema_version": {"const": "1.3"}, "cohort_id": {"$ref": "provenance.schema.json#/properties/cohort_id"}, "case_id": {"$ref": "provenance.schema.json#/properties/case_id"}, "contract": {"$ref": "provenance.schema.json#/properties/contract"}, "ninjatrader_version": {"$ref": "provenance.schema.json#/properties/ninjatrader_version"}, "provider_acquisition": {"$ref": "provenance.schema.json#/properties/provider_acquisition"}, "application_timezone": {"$ref": "provenance.schema.json#/properties/application_timezone"}, "pc_log_timezone": {"$ref": "provenance.schema.json#/properties/pc_log_timezone"}, "trading_hours": {"$ref": "provenance.schema.json#/properties/trading_hours"}, "bar_series": {"$ref": "provenance.schema.json#/properties/bar_series"}, "source": {"$ref": "provenance.schema.json#/properties/source"}, "artifact_hashes": {"$ref": "provenance.schema.json#/properties/artifact_hashes"},
    "selection_binding": {"$ref": "#/$defs/selection_binding"}, "inventory_binding": {"$ref": "#/$defs/v2_artifact_binding"}, "exclusion_binding": {"$ref": "#/$defs/v2_artifact_binding"}, "toolset_binding": {"$ref": "#/$defs/toolset_binding"}, "trusted_inventory_checkpoint": {"$ref": "#/$defs/commit"}, "checkpoint_verification": {"$ref": "checkpoint_attestation_v2.schema.json"}, "selected_source_binding": {"type": "object", "additionalProperties": false, "required": ["expected_sha256", "observed_sha256"], "properties": {"expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "observed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "source_quality_findings": {"$ref": "provenance.schema.json#/properties/source_quality_findings"}, "transformations": {"$ref": "provenance.schema.json#/properties/transformations"}, "approved_policy": {"$ref": "provenance.schema.json#/properties/approved_policy"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "v2_artifact_binding": {"type": "object", "additionalProperties": false, "required": ["path", "schema_version", "sha256", "producing_checkpoint"], "properties": {"path": {"type": "string", "minLength": 1}, "schema_version": {"const": "2.0"}, "sha256": {"$ref": "#/$defs/sha256"}, "producing_checkpoint": {"$ref": "#/$defs/commit"}}},
    "selection_binding": {"type": "object", "additionalProperties": false, "required": ["status", "producing_checkpoint", "trusted_checkpoint", "aggregate_payload_sha256", "selection", "inventory", "exclusion_ledger"], "properties": {"status": {"const": "FROZEN_FOR_SOURCE_ACQUISITION"}, "producing_checkpoint": {"$ref": "#/$defs/commit"}, "trusted_checkpoint": {"$ref": "#/$defs/commit"}, "aggregate_payload_sha256": {"$ref": "#/$defs/sha256"}, "selection": {"$ref": "provenance.schema.json#/properties/selection_binding/properties/selection"}, "inventory": {"$ref": "#/$defs/v2_artifact_binding"}, "exclusion_ledger": {"$ref": "#/$defs/v2_artifact_binding"}}},
    "toolset_binding": {"type": "object", "additionalProperties": false, "required": ["status", "stage", "schema_version", "producing_checkpoint", "trusted_checkpoint", "pinned_production_hierarchy_commit", "aggregate_payload_sha256"], "properties": {"status": {"const": "FROZEN_FOR_INVENTORY"}, "stage": {"const": "INVENTORY_VALIDATION"}, "schema_version": {"const": "2.0"}, "producing_checkpoint": {"$ref": "#/$defs/commit"}, "trusted_checkpoint": {"$ref": "#/$defs/commit"}, "pinned_production_hierarchy_commit": {"const": "04a73e1401d44688660b211d9db6918113482856"}, "aggregate_payload_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
