{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sikaodeluwei/trader_v1/validation/mnq_5m_multiwindow/schemas/inventory_provenance.schema.json",
  "title": "MNQ five-minute inventory-stage provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "acquisition_id",
    "cohort_id",
    "contract",
    "bar_series",
    "provider_acquisition",
    "calendar_binding",
    "artifact_hashes",
    "external_evidence",
    "inventory_scan_binding",
    "transformations",
    "toolset_binding",
    "checkpoint_verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "PROVEN" },
    "acquisition_id": { "$ref": "#/$defs/acquisition_id" },
    "cohort_id": { "const": "mnq-202609-5m-v1" },
    "contract": { "$ref": "#/$defs/contract" },
    "bar_series": { "$ref": "#/$defs/bar_series" },
    "provider_acquisition": { "$ref": "#/$defs/provider_acquisition" },
    "calendar_binding": { "$ref": "#/$defs/calendar_binding" },
    "artifact_hashes": { "$ref": "#/$defs/artifact_hashes" },
    "external_evidence": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/evidence_file" },
      "allOf": [
        {
          "contains": {
            "properties": { "role": { "const": "ninjatrader_config" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "role": { "const": "ninjatrader_log" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "role": { "const": "ninjatrader_trace" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "inventory_scan_binding": { "$ref": "#/$defs/inventory_scan_binding" },
    "transformations": { "$ref": "#/$defs/transformations" },
    "toolset_binding": { "$ref": "#/$defs/toolset_binding" },
    "checkpoint_verification": { "$ref": "#/$defs/checkpoint_verification" }
  },
  "$defs": {
    "acquisition_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_label", "full_name", "master_name", "expiry_month", "expiry_year"],
      "properties": {
        "contract_label": { "const": "MNQ SEP26" },
        "full_name": { "const": "MNQ SEP26" },
        "master_name": { "const": "MNQ" },
        "expiry_month": { "const": 9 },
        "expiry_year": { "const": 2026 }
      }
    },
    "bar_series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "native"],
      "properties": {
        "type": { "const": "Minute" },
        "value": { "const": 5 },
        "native": { "const": true }
      }
    },
    "provider_acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider_profile_id",
        "runtime_provider_id",
        "trace_adapter",
        "intended_connection_name",
        "active_connection",
        "historical_service",
        "configuration_binding",
        "acquisition_id",
        "lifecycle",
        "historical_request",
        "competing_historical_provider_connections",
        "intended_provider_disconnects",
        "log_timezone_id",
        "log_utc_offset"
      ],
      "properties": {
        "status": { "const": "PROVEN" },
        "provider_profile_id": { "const": "NINJATRADER_TRADOVATE_PROVIDER31_HDS_V1" },
        "runtime_provider_id": { "const": "Provider31" },
        "trace_adapter": { "const": "Tradovate.Adapter" },
        "intended_connection_name": { "const": "My NinjaTrader" },
        "active_connection": { "$ref": "#/$defs/active_connection" },
        "historical_service": { "$ref": "#/$defs/historical_service" },
        "configuration_binding": { "$ref": "#/$defs/configuration_binding" },
        "acquisition_id": { "$ref": "#/$defs/acquisition_id" },
        "lifecycle": { "$ref": "#/$defs/provider_lifecycle" },
        "historical_request": { "$ref": "#/$defs/historical_request" },
        "competing_historical_provider_connections": { "const": 0 },
        "intended_provider_disconnects": { "const": 0 },
        "log_timezone_id": { "type": "string", "minLength": 1 },
        "log_utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" }
      }
    },
    "active_connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provider", "status", "price_status", "instrument_types"],
      "properties": {
        "name": { "const": "My NinjaTrader" },
        "provider": { "const": "Provider31" },
        "status": { "const": "Connected" },
        "price_status": { "const": "Connected" },
        "instrument_types": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "Future" },
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "historical_service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "port", "use_ssl", "connected_at"],
      "properties": {
        "name": { "const": "NinjaTrader HDS" },
        "host": { "type": "string", "pattern": "^hds-us-nt-[0-9]+\\.ninjatrader\\.com$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "use_ssl": { "const": true },
        "connected_at": { "type": "string", "format": "date-time" }
      }
    },
    "configuration_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "preferred_future_connection", "preferred_realtime_future_connection", "saved_connection_matches"],
      "properties": {
        "mode": { "type": "string" },
        "preferred_future_connection": { "type": "string" },
        "preferred_realtime_future_connection": { "type": "string" },
        "saved_connection_matches": { "const": 1 }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "EXPLICIT_PREFERENCE" },
            "preferred_future_connection": { "const": "My NinjaTrader" },
            "preferred_realtime_future_connection": { "const": "My NinjaTrader" }
          }
        },
        {
          "properties": {
            "mode": { "const": "UNIQUE_AUTO_ROUTE" },
            "preferred_future_connection": { "const": "Unknown" },
            "preferred_realtime_future_connection": { "const": "Unknown" }
          }
        }
      ]
    },
    "provider_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_connection_initiated_at",
        "connection_ready_at",
        "pre_request_realtime_at",
        "request_observed_at",
        "post_request_initialized_at",
        "post_request_realtime_at",
        "inventory_scan_armed_at",
        "inventory_scan_completed_at"
      ],
      "properties": {
        "adapter_connection_initiated_at": { "type": "string", "format": "date-time" },
        "connection_ready_at": { "type": "string", "format": "date-time" },
        "pre_request_realtime_at": { "type": "string", "format": "date-time" },
        "request_observed_at": { "type": "string", "format": "date-time" },
        "post_request_initialized_at": { "type": "string", "format": "date-time" },
        "post_request_realtime_at": { "type": "string", "format": "date-time" },
        "inventory_scan_armed_at": { "type": "string", "format": "date-time" },
        "inventory_scan_completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "historical_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_role", "observed_at", "instrument", "requested_start", "requested_end", "provider_request_period", "covers_verified_inventory_bounds"],
      "properties": {
        "source_role": { "const": "ninjatrader_trace" },
        "observed_at": { "type": "string", "format": "date-time" },
        "instrument": { "const": "MNQ SEP26" },
        "requested_start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
        "requested_end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
        "provider_request_period": { "const": "1 Minute" },
        "covers_verified_inventory_bounds": { "const": true }
      }
    },
    "calendar_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "trading_hours_name",
        "civil_date_start",
        "civil_date_end",
        "civil_date_count",
        "session_count",
        "earliest_session_begin",
        "latest_session_end",
        "trading_hours_template_sha256",
        "calendar_binding_sha256"
      ],
      "properties": {
        "status": { "const": "VERIFIED" },
        "trading_hours_name": { "const": "CME US Index Futures ETH" },
        "civil_date_start": { "const": "2026-06-22" },
        "civil_date_end": { "const": "2026-07-24" },
        "civil_date_count": { "const": 33 },
        "session_count": { "type": "integer", "minimum": 1, "maximum": 33 },
        "earliest_session_begin": { "type": "string", "format": "date-time" },
        "latest_session_end": { "type": "string", "format": "date-time" },
        "trading_hours_template_sha256": { "$ref": "#/$defs/sha256" },
        "calendar_binding_sha256": { "$ref": "#/$defs/sha256" },
        "date_disagreements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["civil_date", "reason", "scanner_classification", "template_classification"],
            "properties": {
              "civil_date": { "type": "string", "format": "date" },
              "reason": { "const": "TRADING_HOURS_INCONSISTENCY" },
              "scanner_classification": { "enum": ["SESSION", "NO_SESSION"] },
              "template_classification": { "enum": ["SESSION", "NO_SESSION"] }
            }
          }
        }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_scan", "inventory_runtime_capture", "inventory_acquisition_evidence", "scanner", "trading_hours_template", "ninjatrader_config", "ninjatrader_log", "ninjatrader_trace", "toolset_manifest"],
      "properties": {
        "inventory_scan": { "$ref": "#/$defs/sha256" },
        "inventory_runtime_capture": { "$ref": "#/$defs/sha256" },
        "inventory_acquisition_evidence": { "$ref": "#/$defs/sha256" },
        "scanner": { "$ref": "#/$defs/sha256" },
        "trading_hours_template": { "$ref": "#/$defs/sha256" },
        "ninjatrader_config": { "$ref": "#/$defs/sha256" },
        "ninjatrader_log": { "$ref": "#/$defs/sha256" },
        "ninjatrader_trace": { "$ref": "#/$defs/sha256" },
        "toolset_manifest": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "byte_length"],
      "properties": {
        "role": {
          "enum": ["ninjatrader_config", "ninjatrader_log", "ninjatrader_trace", "trading_hours_template"]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 1 }
      }
    },
    "inventory_scan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "sha256"],
      "properties": {
        "path": { "const": "inventory_scan.json" },
        "schema_version": { "const": "1.0" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "transformations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sorted", "filled", "interpolated", "resampled", "timezone_converted", "back_adjusted"],
      "properties": {
        "sorted": { "const": false },
        "filled": { "const": false },
        "interpolated": { "const": false },
        "resampled": { "const": false },
        "timezone_converted": { "const": false },
        "back_adjusted": { "const": false }
      }
    },
    "toolset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stage",
        "schema_version",
        "producing_checkpoint",
        "trusted_checkpoint",
        "pinned_production_hierarchy_commit",
        "aggregate_payload_sha256"
      ],
      "properties": {
        "status": { "const": "FROZEN_FOR_SOURCE_ACQUISITION" },
        "stage": { "const": "SOURCE_ACQUISITION" },
        "schema_version": { "const": "2.0" },
        "producing_checkpoint": { "$ref": "#/$defs/commit" },
        "trusted_checkpoint": { "$ref": "#/$defs/commit" },
        "pinned_production_hierarchy_commit": {
          "const": "04a73e1401d44688660b211d9db6918113482856"
        },
        "aggregate_payload_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkpoint_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "trusted_toolset_checkpoint", "pinned_production_hierarchy_commit"],
      "properties": {
        "status": { "const": "VERIFIED" },
        "trusted_toolset_checkpoint": { "$ref": "#/$defs/commit" },
        "pinned_production_hierarchy_commit": {
          "const": "04a73e1401d44688660b211d9db6918113482856"
        }
      }
    }
  }
}
