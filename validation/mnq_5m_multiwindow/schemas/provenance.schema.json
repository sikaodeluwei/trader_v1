{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sikaodeluwei/trader_v1/validation/mnq_5m_multiwindow/schemas/provenance.schema.json",
  "title": "MNQ 5-minute cohort source provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "case_id",
    "contract",
    "ninjatrader_version",
    "provider_acquisition",
    "application_timezone",
    "pc_log_timezone",
    "trading_hours",
    "bar_series",
    "source",
    "artifact_hashes",
    "source_quality_findings",
    "transformations",
    "approved_policy"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "cohort_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "contract_label",
        "master_name",
        "instrument_id",
        "expiry_month",
        "expiry_year",
        "exchange"
      ],
      "properties": {
        "contract_label": { "const": "MNQ SEP26" },
        "full_name": { "const": "MNQ 09-26" },
        "master_name": { "const": "MNQ" },
        "instrument_id": { "enum": ["MNQ SEP26", "MNQ 09-26"] },
        "expiry_month": { "const": 9 },
        "expiry_year": { "const": 2026 },
        "exchange": { "type": "string", "minLength": 1 }
      }
    },
    "ninjatrader_version": { "type": "string", "minLength": 1 },
    "provider_acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "intended_provider",
        "intended_connection_name",
        "active_connection",
        "acquisition_id",
        "acquisition_started_at",
        "reload_all_historical_data_initiated_at",
        "matching_historical_request_observed",
        "export_armed_at",
        "export_completed_at",
        "competing_historical_provider_connections",
        "preferred_future_connection",
        "log_timezone_id",
        "log_utc_offset"
      ],
      "properties": {
        "status": { "const": "PROVEN" },
        "intended_provider": { "type": "string", "minLength": 1 },
        "intended_connection_name": { "type": "string", "minLength": 1 },
        "active_connection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "provider", "status", "price_status", "instrument_types"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "provider": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "minLength": 1 },
            "price_status": { "const": "Connected" },
            "instrument_types": {
              "type": "array",
              "contains": { "const": "Future" }
            }
          }
        },
        "acquisition_id": { "type": "string", "minLength": 1 },
        "acquisition_started_at": { "type": "string", "format": "date-time" },
        "reload_all_historical_data_initiated_at": {
          "type": "string",
          "format": "date-time"
        },
        "matching_historical_request_observed": { "const": true },
        "export_armed_at": { "type": "string", "format": "date-time" },
        "export_completed_at": { "type": "string", "format": "date-time" },
        "competing_historical_provider_connections": { "const": 0 },
        "preferred_future_connection": { "type": "string", "minLength": 1 },
        "log_timezone_id": { "type": "string", "minLength": 1 },
        "log_utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" }
      }
    },
    "pc_log_timezone": {
      "type": "object",
      "required": [
        "id",
        "base_utc_offset",
        "supports_dst",
        "acquisition_event_offsets"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "base_utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" },
        "supports_dst": { "type": "boolean" },
        "acquisition_event_offsets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["event", "timestamp", "utc_offset"],
            "properties": {
              "event": { "enum": ["initialized", "armed", "exported"] },
              "timestamp": { "type": "string", "format": "date-time" },
              "utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" }
            }
          }
        }
      }
    },
    "application_timezone": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "standard_name",
        "daylight_name",
        "base_utc_offset",
        "supports_dst",
        "source_timestamp_offsets"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "standard_name": { "type": "string", "minLength": 1 },
        "daylight_name": { "type": "string", "minLength": 1 },
        "base_utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" },
        "supports_dst": { "type": "boolean" },
        "source_timestamp_offsets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["first_timestamp", "last_timestamp", "utc_offset"],
            "properties": {
              "first_timestamp": { "type": "string" },
              "last_timestamp": { "type": "string" },
              "utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" }
            }
          }
        }
      }
    },
    "trading_hours": {
      "type": "object",
      "required": [
        "name",
        "timezone_id",
        "definition_sha256",
        "holiday_configuration_captured",
        "session_calendar"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "timezone_id": { "type": "string", "minLength": 1 },
        "definition_sha256": { "$ref": "#/$defs/sha256" },
        "holiday_configuration_captured": { "const": true },
        "session_calendar": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["trading_date", "segments", "holiday_name", "partial_holiday"],
            "properties": {
              "trading_date": { "type": "string", "format": "date" },
              "segments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "begin_application",
                    "end_application",
                    "begin_pc",
                    "end_pc"
                  ],
                  "properties": {
                    "begin_application": { "type": "string" },
                    "end_application": { "type": "string" },
                    "begin_pc": { "type": "string" },
                    "end_pc": { "type": "string" },
                    "effective_schedule_source": { "type": "string" }
                  }
                }
              },
              "holiday_name": { "type": ["string", "null"] },
              "partial_holiday": { "type": ["boolean", "null"] },
              "effective_schedule_source": { "type": "string" }
            }
          }
        }
      }
    },
    "bar_series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "native", "timestamp_semantics"],
      "properties": {
        "type": { "const": "Minute" },
        "value": { "const": 5 },
        "native": { "const": true },
        "timestamp_semantics": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "trading_date",
        "first_timestamp",
        "last_timestamp",
        "row_count",
        "sha256",
        "original_source_sha256",
        "frozen_case_sha256",
        "exported_at",
        "export_method",
        "original_export_identity",
        "selected_row_derivation",
        "known_missing_bars",
        "scheduled_exclusions",
        "known_limitations"
      ],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "trading_date": {
          "type": "string",
          "format": "date"
        },
        "first_timestamp": { "type": "string" },
        "last_timestamp": { "type": "string" },
        "row_count": { "const": 250 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "original_source_sha256": { "$ref": "#/$defs/sha256" },
        "frozen_case_sha256": { "$ref": "#/$defs/sha256" },
        "exported_at": { "type": "string", "format": "date-time" },
        "export_method": { "type": "string", "minLength": 1 },
        "original_export_identity": { "type": "string", "minLength": 1 },
        "selected_row_derivation": {
          "const": "first 250 native 5-minute bars of the declared Trading Hours session"
        },
        "known_missing_bars": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scheduled_exclusions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "known_limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "runtime_capture",
        "acquisition_evidence",
        "exporter",
        "ninjatrader_trace",
        "ninjatrader_log",
        "ninjatrader_config",
        "trading_hours_template",
        "selection_registry",
        "toolset_manifest"
      ],
      "properties": {
        "source": { "$ref": "#/$defs/sha256" },
        "runtime_capture": { "$ref": "#/$defs/sha256" },
        "acquisition_evidence": { "$ref": "#/$defs/sha256" },
        "exporter": { "$ref": "#/$defs/sha256" },
        "ninjatrader_trace": { "$ref": "#/$defs/sha256" },
        "ninjatrader_log": { "$ref": "#/$defs/sha256" },
        "ninjatrader_config": { "$ref": "#/$defs/sha256" },
        "trading_hours_template": { "$ref": "#/$defs/sha256" },
        "selection_registry": { "$ref": "#/$defs/sha256" },
        "toolset_manifest": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_quality_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "transformations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sorted",
        "filled",
        "interpolated",
        "resampled",
        "timezone_converted",
        "back_adjusted"
      ],
      "properties": {
        "sorted": { "const": false },
        "filled": { "const": false },
        "interpolated": { "const": false },
        "resampled": { "const": false },
        "timezone_converted": { "const": false },
        "back_adjusted": { "const": false }
      }
    },
    "approved_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "candidate_date_start",
        "candidate_date_end",
        "single_expiry_only",
        "existing_frozen_5m_case_excluded",
        "june_rollover_transition_excluded"
      ],
      "properties": {
        "contract": { "const": "MNQ September 2026" },
        "candidate_date_start": { "const": "2026-06-22" },
        "candidate_date_end": { "const": "2026-07-24" },
        "single_expiry_only": { "const": true },
        "existing_frozen_5m_case_excluded": { "const": true },
        "june_rollover_transition_excluded": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
