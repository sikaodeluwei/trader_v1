{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sikaodeluwei/trader_v1/validation/mnq_5m_multiwindow/schemas/toolset_manifest.schema.json",
  "title": "MNQ 5-minute frozen validation toolset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "cohort_id",
    "producing_checkpoint",
    "pinned_production_hierarchy_commit",
    "runtime",
    "canonicalization",
    "components",
    "deferred_components",
    "aggregate_payload_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "stage": { "const": "SOURCE_ACQUISITION" },
    "status": { "const": "FROZEN_FOR_SOURCE_ACQUISITION" },
    "cohort_id": { "const": "mnq-202609-5m-v1" },
    "producing_checkpoint": { "$ref": "#/$defs/commit" },
    "pinned_production_hierarchy_commit": {
      "const": "04a73e1401d44688660b211d9db6918113482856"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "dependencies"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "canonicalization": {
      "const": "JSON_UTF8_SORTED_KEYS_COMPACT_EXCLUDE_AGGREGATE_PAYLOAD_SHA256"
    },
    "components": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "bundle_path", "sha256", "producing_commit"],
        "properties": {
          "role": {
            "enum": [
              "protocol_spec",
              "acquisition_exporter",
              "acquisition_finalizer",
              "provenance_schema",
              "selection_registry_schema",
              "toolset_manifest_schema",
              "source_inventory_schema",
              "exclusion_ledger_schema"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "bundle_path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "producing_commit": { "$ref": "#/$defs/commit" }
        }
      }
    },
    "deferred_components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "independent_oracle",
          "blind_project_runner",
          "comparator",
          "cohort_aggregator"
        ]
      }
    },
    "aggregate_payload_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
