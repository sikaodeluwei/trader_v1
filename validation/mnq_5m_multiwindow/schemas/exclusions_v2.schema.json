{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sikaodeluwei/trader_v1/validation/mnq_5m_multiwindow/schemas/exclusions_v2.schema.json",
  "title": "MNQ 5-minute versioned source exclusion ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "cohort_outcome", "cohort_id", "source_inventory_sha256", "producing_checkpoint", "entries", "aggregate_payload_sha256"],
  "properties": {
    "schema_version": {"const": "2.0"}, "status": {"const": "FROZEN_INVENTORY"},
    "cohort_outcome": {"enum": ["READY_FOR_SELECTION", "COHORT_INCOMPLETE"]}, "cohort_id": {"const": "mnq-202609-5m-v1"},
    "source_inventory_sha256": {"$ref": "#/$defs/sha256"}, "producing_checkpoint": {"$ref": "#/$defs/commit"},
    "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["trading_date", "reasons"], "properties": {"trading_date": {"type": "string", "format": "date"}, "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/normally_emitted_exclusion_reason"}}}}},
    "aggregate_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "exclusion_reason": {"enum": ["INCOMPLETE_PROVENANCE", "FEWER_THAN_250_NATIVE_BARS", "DUPLICATE_OR_NON_MONOTONIC_TIMESTAMPS", "TRADING_HOURS_INCONSISTENCY", "MALFORMED_OR_NON_FINITE_OHLCV", "INVALID_OHLC_GEOMETRY", "UNEXPECTED_MISSING_BARS", "SOURCE_CORRUPTION", "SOURCE_HASH_MISMATCH", "OUTSIDE_POLICY"]},
    "normally_emitted_exclusion_reason": {"enum": ["INCOMPLETE_PROVENANCE", "FEWER_THAN_250_NATIVE_BARS", "DUPLICATE_OR_NON_MONOTONIC_TIMESTAMPS", "TRADING_HOURS_INCONSISTENCY", "MALFORMED_OR_NON_FINITE_OHLCV", "INVALID_OHLC_GEOMETRY", "UNEXPECTED_MISSING_BARS", "SOURCE_CORRUPTION"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
